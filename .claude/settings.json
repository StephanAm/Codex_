{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(npm run *)",
      "Bash(git *)",
      "Bash(./apps/*/gui/gui.sh *)",
      "Bash(./apps/*/scripts/release.sh *)",
      "Bash(./apps/scripts/check.sh)",
      "Skill(update-config:*)"
    ],
    "additionalDirectories": [
      "/home/stephan/.claude/commands",
      "/tmp",
      "/home/stephan/Code/codex/.claude"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff check 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running ruff check..."
          },
          {
            "type": "command",
            "command": "uv run ruff format --check 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running ruff format check..."
          },
          {
            "type": "command",
            "command": "uv run mypy 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running mypy..."
          },
          {
            "type": "command",
            "command": "uv run pytest 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running pytest..."
          }
        ]
      }
    ]
  }
}
