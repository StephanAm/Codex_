{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(python pack.py)",
      "Bash(npm run *)",
      "Bash(git *)",
      "Bash(./gui/gui.sh build *)",
      "Bash(./scripts/bump_version.sh *)",
      "Skill(update-config:*)",
      "Bash(./scripts/release.sh)",
      "Bash(./scripts/release.sh minor *)",
      "Bash(grep -E '\\\\.\\(tsx|ts\\)$')",
      "Bash(cat > *)"
    ],
    "additionalDirectories": [
      "/home/stephan/.claude/commands",
      "/tmp"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/commit_on_stop.py"
          },
          {
            "type": "command",
            "command": "uv run ruff check 2>&1 || true",
            "statusMessage": "Running ruff check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/remind_commit.py",
            "statusMessage": "Checking commit status..."
          }
        ]
      }
    ]
  }
}
