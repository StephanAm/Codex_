{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(npm run *)",
      "Bash(git *)",
      "Bash(./apps/*/gui/gui.sh *)",
      "Bash(./apps/*/scripts/release.sh *)",
      "Bash(./apps/scripts/check.sh)",
      "Skill(update-config:*)",
      "Bash(pnpm add *)",
      "Bash(pnpm --filter ./apps/mnemo/gui build)",
      "Bash(chmod +x /home/stephan/Code/codex/apps/cartographer/scripts/bump_version.sh /home/stephan/Code/codex/apps/cartographer/scripts/update_changelog.sh)",
      "Bash(chmod +x /home/stephan/Code/codex/apps/scribe/gen_bulletins.sh)",
      "Bash(chmod +x /home/stephan/Code/codex/migrate_dotfiles.sh)"
    ],
    "additionalDirectories": [
      "/home/stephan/.claude/commands",
      "/tmp",
      "/home/stephan/Code/codex/.claude"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format 2>/dev/null || true",
            "statusMessage": "Formatting Python files..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff check 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running ruff check..."
          },
          {
            "type": "command",
            "command": "uv run ruff format --check 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running ruff format check..."
          },
          {
            "type": "command",
            "command": "uv run mypy 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running mypy..."
          },
          {
            "type": "command",
            "command": "uv run pytest 2>&1 || true",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Running pytest..."
          },
          {
            "type": "command",
            "command": "cd /home/stephan/Code/codex/apps/mnemo/gui && pnpm exec tsc --noEmit 2>&1 || true",
            "if": "Edit(*.ts)|Edit(*.tsx)|Write(*.ts)|Write(*.tsx)",
            "statusMessage": "Running tsc..."
          }
        ]
      }
    ]
  }
}
