                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Clear session context",
        "description": "Clear the active session, removing any automatically applied tags and references.",
        "operationId": "delete_session_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/sync": {
      "post": {
        "summary": "Push and pull (full sync)",
        "description": "Upload the local database to the configured sync target, then pull and merge changes from all other devices.\n\nReturns a result message and a `needs_auth` flag. When `needs_auth` is `true`,\nthe user must complete Google Drive authorisation via `POST /auth/google` before syncing.",
        "operationId": "run_sync_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Run Sync Sync Post"
                }
              }
            }
          }
        }
      }
    },
    "/sync/push": {
      "post": {
        "summary": "Push local changes",
        "description": "Upload the local database to the configured sync target without pulling remote changes.\n\nReturns a result message and a `needs_auth` flag.",
        "operationId": "run_push_sync_push_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Run Push Sync Push Post"
                }
              }
            }
          }
        }
      }
    },
    "/sync/pull": {
      "post": {
        "summary": "Pull remote changes",
        "description": "Download and merge databases from all other known devices without pushing local changes.\n\nReturns a result message and a `needs_auth` flag.",
        "operationId": "run_pull_sync_pull_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Run Pull Sync Pull Post"
                }
              }
            }
          }
        }
      }
    },
