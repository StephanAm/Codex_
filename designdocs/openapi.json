    "/session": {
      "get": {
        "summary": "Get session context",
        "description": "Return the active session tags and references.\n\nSession context is applied automatically to all notes created during the session.\nIt is process-local and not persisted to the database.",
        "operationId": "get_session_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
