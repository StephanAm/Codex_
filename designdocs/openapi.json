                  "type": "object",
                  "title": "Response Get Session Session Get"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Set session context",
        "description": "Set the active session tags and references.\n\nAny tags and references supplied here will be automatically attached to every note\ncreated while the session is active.",
        "operationId": "set_session_session_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPayload"
              }
            }
          },
          "required": true
